
@page
@model PassoCerto.Web.Pages.Admin.Checklist.IndexModel

@{
    ViewData["Title"] = "Gerenciar checklist";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold">Checklist</h1>
            <p class="text-muted mb-0">
                Gerencie as categorias utilizadas nas inspeções.
            </p>
        </div>

        <a asp-page="/Admin/Checklist/Categorias/Criar"
           class="btn btn-primary">
            + Nova categoria
        </a>
        <a asp-page="/Admin/Checklist/Itens/Index"
           class="btn btn-outline-primary">
            Gerenciar itens
        </a>
    </div>

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="alert alert-success">
            @sucesso
        </div>
    }

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert alert-danger">
            @erro
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0">Categorias</h2>
        </div>

        <div class="card-body">

            @if (!Model.Categorias.Any())
            {
                <div class="alert alert-info mb-0">
                    Nenhuma categoria cadastrada.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Ordem</th>
                                <th>Situação</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var categoria in Model.Categorias)
                            {
                                <tr>
                                    <td>@categoria.Id</td>
                                    <td class="fw-semibold">
                                        @categoria.Nome
                                    </td>
                                    <td>@categoria.Ordem</td>

                                    <td>
                                        @if (categoria.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativa
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex gap-2
                                                    justify-content-end">

                                            <a asp-page="/Admin/Checklist/Categorias/Editar"
                                               asp-route-id="@categoria.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            @if (categoria.Ativo)
                                            {
                                                <form method="post"
                                                      asp-page-handler="Desativar"
                                                      asp-route-id="@categoria.Id">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Deseja desativar esta categoria?')">
                                                        Desativar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="Reativar"
                                                      asp-route-id="@categoria.Id">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Reativar
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <a asp-page="/Admin/Index"
       class="btn btn-outline-secondary mt-4">
        Voltar ao painel
    </a>

</div>
