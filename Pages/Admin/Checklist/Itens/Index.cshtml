@page
@model PassoCerto.Web.Pages.Admin.Checklist.Itens.IndexModel

@{
    ViewData["Title"] = "Itens do checklist";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold">Itens do checklist</h1>
            <p class="text-muted">Gerencie as verificações das inspeções.</p>
        </div>

        <a asp-page="Criar" class="btn btn-primary">
            + Novo item
        </a>
    </div>

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="alert alert-success">@sucesso</div>
    }

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert alert-danger">@erro</div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Ordem</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>
                                <strong>@item.Titulo</strong>
                                <div class="text-muted small">
                                    @item.Descricao
                                </div>
                            </td>

                            <td>
                                @(Model.Categorias.TryGetValue(
                                    item.CategoriaId, out var nome)
                                    ? nome : "Categoria não encontrada")
                            </td>

                            <td>@item.Ordem</td>

                            <td>
                                @if (item.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-page="Editar"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <form method="post"
                                          asp-page-handler="@(item.Ativo ? "Desativar" : "Reativar")"
                                          asp-route-id="@item.Id">
                                        <button type="submit"
                                                class="btn btn-sm @(item.Ativo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(item.Ativo ? "Desativar" : "Reativar")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Itens.Any())
            {
                <p class="text-muted">Nenhum item cadastrado.</p>
            }
        </div>
    </div>

    <a asp-page="/Admin/Checklist/Index"
       class="btn btn-outline-secondary mt-3">
        Voltar às categorias
    </a>
</div>
