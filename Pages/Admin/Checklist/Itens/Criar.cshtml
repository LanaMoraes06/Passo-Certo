@page
@model PassoCerto.Web.Pages.Admin.Checklist.Itens.CriarModel

@{
    ViewData["Title"] = "Novo item";
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">Cadastrar item do checklist</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.CategoriaId"
                           class="form-label">Categoria</label>

                    <select asp-for="Input.CategoriaId"
                            asp-items="Model.Categorias"
                            class="form-select">
                        <option value="0">Selecione uma categoria</option>
                    </select>

                    <span asp-validation-for="Input.CategoriaId"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Titulo"
                           class="form-label">Título</label>

                    <input asp-for="Input.Titulo"
                           class="form-control" />

                    <span asp-validation-for="Input.Titulo"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Descricao"
                           class="form-label">Descrição</label>

                    <textarea asp-for="Input.Descricao"
                              class="form-control" rows="3"></textarea>

                    <span asp-validation-for="Input.Descricao"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Ordem"
                           class="form-label">Ordem</label>

                    <input asp-for="Input.Ordem"
                           type="number" min="1"
                           class="form-control" />

                    <span asp-validation-for="Input.Ordem"
                          class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Cadastrar item
                </button>

                <a asp-page="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
