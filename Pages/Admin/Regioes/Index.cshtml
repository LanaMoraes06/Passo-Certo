@page
@model PassoCerto.Web.Pages.Admin.Regioes.IndexModel

@{
    ViewData["Title"] = "Regiões";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold">Regiões</h1>
            <p class="text-muted mb-0">
                Gerencie as regiões do PassoCerto.
            </p>
        </div>

        <a asp-page="Criar" class="btn btn-primary">
            Nova região
        </a>

    </div>

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="alert alert-success">
            @sucesso
        </div>
    }

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert alert-danger">
            @erro
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Regioes.Any())
            {
                <p class="text-muted mb-0">
                    Nenhuma região ativa cadastrada.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Situação</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var regiao in Model.Regioes)
                            {
                                <tr>
                                    <td>@regiao.Id</td>

                                    <td>@regiao.Nome</td>

                                    <td>
                                        <span class="badge bg-success">
                                            Ativa
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex gap-2
                                                    justify-content-end">

                                            <a asp-page="Editar"
                                               asp-route-id="@regiao.Id"
                                               class="btn btn-sm
                                                      btn-outline-primary">
                                                Editar
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Desativar"
                                                  asp-route-id="@regiao.Id">

                                                <button type="submit"
                                                        class="btn btn-sm
                                                               btn-outline-danger"
                                                        onclick="return confirm('Deseja desativar esta região?')">
                                                    Desativar
                                                </button>

                                            </form>

                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

</div>
