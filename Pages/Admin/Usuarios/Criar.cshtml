@page
@using PassoCerto.Web.Models.Enum
@model PassoCerto.Web.Pages.Admin.Usuarios.CriarModel

@{
    ViewData["Title"] = "Cadastrar usuário";
}

<div class="container py-4">

    <h1 class="h3 fw-bold">Cadastrar usuário</h1>

    <p class="text-muted">
        Crie uma conta de acesso ao PassoCerto.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Input.Login"
                               class="form-label"></label>

                        <input asp-for="Input.Login"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Input.Login"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Perfil"
                               class="form-label"></label>

                        <select asp-for="Input.Perfil"
                                class="form-select">
                            <option value="">
                                Selecione um perfil
                            </option>

                            @foreach (var perfil in Enum.GetValues<PerfilUsuario>())
                            {
                                <option value="@perfil">
                                    @perfil
                                </option>
                            }
                        </select>

                        <span asp-validation-for="Input.Perfil"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Senha"
                               class="form-label">
                            Senha
                        </label>

                        <input asp-for="Input.Senha"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               minlength="8" />

                        <span asp-validation-for="Input.Senha"
                              class="text-danger small"></span>

                        <div class="form-text">
                            Utilize pelo menos 8 caracteres.
                        </div>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Cadastrar usuário
                    </button>

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
