@page "{id:long}"
@model PassoCerto.Web.Pages.Admin.Lojas.EditarModel

@{
    ViewData["Title"] = "Editar loja";
}

<div class="container py-4">

    <h1 class="h3 fw-bold">Editar loja</h1>

    <p class="text-muted">
        Atualize os dados da unidade selecionada.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post">

                <input type="hidden" asp-for="Input.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Input.Codigo"
                               class="form-label"></label>

                        <input asp-for="Input.Codigo"
                               class="form-control" />

                        <span asp-validation-for="Input.Codigo"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Input.Nome"
                               class="form-label"></label>

                        <input asp-for="Input.Nome"
                               class="form-control" />

                        <span asp-validation-for="Input.Nome"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.GerenteNome"
                               class="form-label"></label>

                        <input asp-for="Input.GerenteNome"
                               class="form-control" />

                        <span asp-validation-for="Input.GerenteNome"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.RegiaoId"
                               class="form-label"></label>

                        <select asp-for="Input.RegiaoId"
                                asp-items="Model.Regioes"
                                class="form-select">
                            <option value="0">
                                Selecione uma região
                            </option>
                        </select>

                        <span asp-validation-for="Input.RegiaoId"
                              class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
