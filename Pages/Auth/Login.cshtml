
@page
@model PassoCerto.Web.Pages.Auth.LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-12 col-md-5 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">
                        Passo Certo
                    </h2>

                    <p class="text-muted text-center mb-4">
                        Sistema de Inspeção de Lojas
                    </p>

                    <form method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Login"
                                   class="form-label">
                                Login
                            </label>

                            <input asp-for="Input.Login"
                                   class="form-control"
                                   autocomplete="username" />

                            <span asp-validation-for="Input.Login"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Senha"
                                   class="form-label">
                                Senha
                            </label>

                            <input asp-for="Input.Senha"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Input.Senha"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Entrar
                        </button>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
