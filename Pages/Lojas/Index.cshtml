@page
@model PassoCerto.Web.Pages.Lojas.IndexModel

@{
    ViewData["Title"] = "Lojas";
}

<div class="container mt-4">

    <h1 class="mb-4">Lojas</h1>

    <p class="text-muted">
        Consulte as lojas disponíveis para seu perfil.
    </p>

    @if (!Model.Lojas.Any())
    {
        <div class="alert alert-info">
            Nenhuma loja encontrada.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nome</th>
                        <th>Gerente</th>
                        <th>Situação</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loja in Model.Lojas)
                    {
                        <tr>
                            <td>@loja.Codigo</td>
                            <td>@loja.Nome</td>
                            <td>@loja.GerenteNome</td>
                            <td>
                                <span class="badge bg-success">
                                    Ativa
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>