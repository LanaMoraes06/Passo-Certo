@page "{id:long}"
@model PassoCerto.Web.Pages.Inspecoes.DetalhesModel

@{
    ViewData["Title"] = "Detalhes da inspeção";
}

<div class="d-flex justify-content-between
            align-items-center mb-4">

    <div>
        <h1 class="h3">
            Inspeção #@Model.Inspecao.Id
        </h1>
        <p class="text-muted mb-0">
            Loja @Model.Inspecao.LojaId
            • @Model.Inspecao.DataVisita.ToString("dd/MM/yyyy")
        </p>
    </div>

    <span class="badge bg-secondary fs-6">
        @Model.Inspecao.Status
    </span>
</div>

@if (TempData["Sucesso"] is string mensagem)
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<form method="post">

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Checklist da visita</strong>
        </div>

        <div class="card-body">

            @if (!Model.Itens.Any())
            {
                <div class="alert alert-warning">
                    Nenhum item encontrado para esta inspeção.
                </div>
            }

            @for (int i = 0; i < Model.Itens.Count; i++)
            {
                var item = Model.Itens[i];

                <div class="border-bottom py-3">

                    <input type="hidden"
                           asp-for="Input.Respostas[i].Id" />

                    <h2 class="h6 mb-3">
                        @(i + 1). @item.ItemTitulo
                    </h2>

                    <div class="mb-3">
                        <label class="form-label">
                            Resposta
                        </label>

                        <select asp-for="Input.Respostas[i].Resposta"
                                class="form-select"
                                disabled="@(!Model.PodeEditar)">

                            <option value="">
                                Selecione uma resposta
                            </option>

                            @foreach (var opcao in Model.OpcoesResposta)
                            {
                                <option value="@opcao">
                                    @opcao
                                </option>
                            }
                        </select>

                        <span asp-validation-for="Input.Respostas[i].Resposta"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">
                            Observação
                        </label>

                        <textarea asp-for="Input.Respostas[i].Observacao"
                                  class="form-control"
                                  rows="2"
                                  disabled="@(!Model.PodeEditar)"
                                  placeholder="Obrigatória para respostas PENDENTE"></textarea>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between gap-2">

        <a asp-page="/Inspecoes/Index"
           class="btn btn-outline-secondary">
            Voltar
        </a>

        @if (Model.PodeEditar)
        {
            <div class="d-flex gap-2">

                <button type="submit"
                        asp-page-handler="Salvar"
                        class="btn btn-outline-primary">
                    Salvar rascunho
                </button>

                <button type="submit"
                        asp-page-handler="Concluir"
                        class="btn btn-success"
                        onclick="return confirm('Deseja concluir esta inspeção?');">
                    Concluir inspeção
                </button>

            </div>
        }

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}